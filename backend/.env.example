# Server Configuration
HOST=0.0.0.0
PORT=8000

# Administrator Security Key (Protecting /api/admin/* synchronization controls)
ADMIN_API_KEY=your_secure_admin_key_here

# Scheduler Configuration
DEFAULT_SYNC_INTERVAL_MINUTES=60
MAX_PAGES_PER_SYNC=30
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=12

# LLM Configuration
# 1. Google Gemini API (Recommended primary model for fast, high-quality responses in Tamil & English)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Local Ollama Fallback (Free, runs offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 3. OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# RAG Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_RESULTS=4
