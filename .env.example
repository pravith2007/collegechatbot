# KEC AI Assistant Configuration Template

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Administrator Security Key (Required for Admin Synchronization Dashboard)
ADMIN_API_KEY=kec_admin_secure_2026

# Scheduler Configuration
DEFAULT_SYNC_INTERVAL_MINUTES=60
MAX_PAGES_PER_SYNC=30
REQUEST_DELAY_SECONDS=1.0

# LLM Providers (Optional - System works completely offline using built-in grounded synthesizer)
# Local Ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
